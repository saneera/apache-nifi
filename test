apiVersion: v1
kind: Secret
metadata:
  name: openfire-tls
  namespace: <openfire-ns>
type: Opaque
data:
  openfire.p12: <base64 of openfire.p12>
  ca.crt: <base64 of ca.crt>
stringData:
  storepass: changeit



  base64 -w0 openfire.p12
  base64 -w0 ca.crt

