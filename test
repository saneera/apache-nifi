mkdir -p /c/certs && cd /c/certs
export MSYS_NO_PATHCONV=1      # stops Git Bash mangling "/CN=..." into a Windows path

# 1a. Your own CA
openssl req -x509 -newkey rsa:4096 -nodes -sha256 -days 1825 \
  -keyout ca.key -out ca.crt -subj "/CN=HFC2 Dev CA"

# 1b. Openfire key + request
openssl req -newkey rsa:2048 -nodes -sha256 \
  -keyout openfire.key -out openfire.csr -subj "/CN=openfire-xmpp-dev1"

# 1c. What goes in the cert (names the clients will connect with)
cat > openfire.ext <<'EOF'
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = DNS:openfire-xmpp-dev1, DNS:openfire-service, IP:10.11.253.93
EOF

# 1d. Sign it with your CA
openssl x509 -req -in openfire.csr -CA ca.crt -CAkey ca.key -CAcreateserial \
  -days 825 -sha256 -extfile openfire.ext -out openfire.crt

# 1e. Bundle cert + key as PKCS12 (keytool in the pod can import this)
openssl pkcs12 -export -in openfire.crt -inkey openfire.key -certfile ca.crt \
  -name openfire -out openfire.p12 -passout pass:changeit


---

openssl s_client -connect 10.11.253.93:30522 -starttls xmpp \
  -servername openfire-xmpp-dev1 -showcerts </dev/null 2>/dev/null \
  | openssl x509 -outform PEM > openfire.crt


  kubectl exec deploy/openfire -c openfire -- keytool -exportcert -rfc \
    -alias <OPENFIRE_FQDN> -keystore /var/lib/openfire/conf/security/keystore \
    -storepass changeit > openfire.crt

    openssl x509 -in openfire.crt -noout -subject -ext subjectAltName

  ---
          - name: generate-keystore
            image: openfire-image
            command: ["sh", "-c"]
            args:
              - |
                set -e
                SECURITY_DIR="/conf-out/security"
                DEFAULTS_DIR="/usr/local/openfire/resources/security_org"
                KEYSTORE="$SECURITY_DIR/keystore"
                TRUSTSTORE="$SECURITY_DIR/truststore"

                mkdir -p "$SECURITY_DIR"

                # Keep the existing seeding of default files
                for f in client.truststore java.security; do
                  if [ ! -f "$SECURITY_DIR/$f" ] && [ -f "$DEFAULTS_DIR/$f" ]; then
                    cp -f "$DEFAULTS_DIR/$f" "$SECURITY_DIR/$f"
                    chown openfire:openfire "$SECURITY_DIR/$f"
                    echo "Seeded default $f"
                  fi
                done

                # Always rebuild from the Secret - the Secret is the source of truth
                rm -f "$KEYSTORE" "$TRUSTSTORE"

                keytool -importkeystore -noprompt \
                  -srckeystore /tls/openfire.p12 -srcstoretype PKCS12 \
                  -srcstorepass "$STOREPASS" -srcalias openfire \
                  -destkeystore "$KEYSTORE" -deststoretype JKS \
                  -deststorepass "$STOREPASS" -destkeypass "$STOREPASS" \
                  -destalias "$OPENFIRE_FQDN"

                keytool -importcert -noprompt -alias hfc2-ca -file /tls/ca.crt \
                  -keystore "$TRUSTSTORE" -storetype JKS -storepass "$STOREPASS"

                chown openfire:openfire "$KEYSTORE" "$TRUSTSTORE"
                keytool -list -keystore "$KEYSTORE" -storepass "$STOREPASS"
                echo "Imported TLS certificate for $OPENFIRE_FQDN"
            env:
              - name: STOREPASS
                valueFrom:
                  secretKeyRef:
                    name: openfire-tls
                    key: storepass
            envFrom:
              - configMapRef:
                  name: openfire-env
            volumeMounts:
              - name: openfire-config
                mountPath: /conf-out
              - name: openfire-tls
                mountPath: /tls
                readOnly: true






  ---
  chat-gateway:
    openfire:
      trustCertPath: "C:/certs/ca.crt"

