INSERT INTO ofProperty (name, propValue) VALUES ('plugin.restapi.enabled', 'true') ON DUPLICATE KEY UPDATE propValue='true';
INSERT INTO ofProperty (name, propValue) VALUES ('plugin.restapi.httpAuth', 'secretKey') ON DUPLICATE KEY UPDATE propValue='secretKey';
INSERT INTO ofProperty (name, propValue) VALUES ('plugin.restapi.secret', 'your-api-key') ON DUPLICATE KEY UPDATE propValue='your-api-key';
INSERT INTO ofProperty (name, propValue) VALUES ('plugin.restapi.allowedIPs', '*') ON DUPLICATE KEY UPDATE propValue='*';
INSERT INTO ofProperty (name, propValue) VALUES ('adminConsole.access.allow-wildcards-in-excludes', 'true') ON DUPLICATE KEY UPDATE propValue='true';



FROM ghcr.io/igniterealtime/openfire:latest

ENV OPENFIRE_DATA=/var/lib/openfire

# 1. Copy the plugin and config
COPY restAPI.jar ${OPENFIRE_DATA}/plugins/restAPI.jar
COPY openfire.xml ${OPENFIRE_DATA}/conf/openfire.xml

# 2. Copy the SQL to be injected (you may need to run this manually or via entrypoint)
COPY init-restapi.sql ${OPENFIRE_DATA}/init-restapi.sql

USER root
# Pre-create the embedded-db folder in the persistent path
RUN mkdir -p ${OPENFIRE_DATA}/embedded-db && \
chown -R openfire:openfire ${OPENFIRE_DATA} ${OPENFIRE_HOME}
USER openfire


piVersion: apps/v1
kind: Deployment
metadata:
name: openfire
spec:
template:
spec:
initContainers:

name: copy-plugins
image: your-username/openfire-custom:v1 # Use your custom image here
command: ['sh', '-c', 'cp -r /usr/local/openfire/plugins/* /data/plugins/ && cp /usr/local/openfire/conf/openfire.xml /data/conf/openfire.xml']
volumeMounts:

name: openfire-data
mountPath: /data # Mount the PVC here to prep it
containers:

name: openfire
image: your-username/openfire-custom:v1
volumeMounts:

name: openfire-data
mountPath: /var/lib/openfire # Final mount where Openfire looks for data
volumes:

name: openfire-data
persistentVolumeClaim:
claimName: openfire-pvc
