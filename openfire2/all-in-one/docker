FROM ghcr.io/igniterealtime/openfire:latest

ENV OPENFIRE_DATA=/var/lib/openfire

# 1. Copy the plugin and config
COPY restAPI.jar ${OPENFIRE_DATA}/plugins/restAPI.jar
COPY openfire.xml ${OPENFIRE_DATA}/conf/openfire.xml

# 2. Copy the SQL to be injected (you may need to run this manually or via entrypoint)
COPY init-restapi.sql ${OPENFIRE_DATA}/init-restapi.sql

USER root
# Pre-create the embedded-db folder in the persistent path
RUN mkdir -p ${OPENFIRE_DATA}/embedded-db && \
chown -R openfire:openfire ${OPENFIRE_DATA} ${OPENFIRE_HOME}
USER openfire


