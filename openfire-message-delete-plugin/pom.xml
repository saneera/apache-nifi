                    </Plugin-Class>
                </manifestEntries>
            </archive>
        </configuration>
    </plugin>

    <!-- Step 2: assemble final plugin JAR with lib/ structure -->
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
            <execution>
                <id>make-plugin-jar</id>
                <phase>package</phase>
                <goals>
                    <goal>single</goal>
