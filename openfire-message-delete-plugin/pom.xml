<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.babcock.openfire</groupId>
    <artifactId>message-delete-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Message Delete Plugin</name>
    <description>
        Openfire plugin that exposes a REST endpoint to delete/retract
        a MUC message from ofMessageArchive by messageId.
    </description>

    <properties>
        <java.version>11</java.version>
        <openfire.version>5.0.4</openfire.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Openfire core — provided by the server at runtime -->
        <dependency>
            <groupId>org.igniterealtime.openfire</groupId>
            <artifactId>xmppserver</artifactId>
            <version>${openfire.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jersey for REST — provided by Openfire admin console -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-server</artifactId>
            <version>2.40</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet</artifactId>
            <version>2.40</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Openfire reads these to register the plugin -->
                            <Plugin-Class>
                                com.babcock.openfire.plugin.MessageDeletePlugin
                            </Plugin-Class>
                        </manifestEntries>
                    </archive>
                    <!-- Output to plugins directory name expected by Openfire -->
                    <finalName>message-delete</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>igniterealtime</id>
            <name>Ignite Realtime Repository</name>
            <url>https://igniterealtime.org/archiva/repository/maven/</url>
        </repository>
    </repositories>
</project>



<build>
<finalName>muc-message-delete</finalName>

<plugins>
    <!-- ── Disable Spring Boot repackage — this is NOT a Spring Boot app ── -->
    <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
            <execution>
                <id>repackage</id>
                <phase>none</phase>   <!-- ← skip repackage entirely -->
            </execution>
        </executions>
    </plugin>

    <!-- ── Copy plugin.xml to JAR root ───────────────────────────────── -->
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
            <execution>
                <id>copy-plugin-xml</id>
                <phase>process-resources</phase>
                <goals>
                    <goal>copy-resources</goal>
                </goals>
                <configuration>
                    <outputDirectory>
                        ${project.build.outputDirectory}
                    </outputDirectory>
                    <resources>
                        <resource>
                            <!-- plugin.xml from resources goes to JAR root -->
                            <directory>src/main/resources</directory>
                            <includes>
                                <include>plugin.xml</include>
                            </includes>
                        </resource>
                    </resources>
                </configuration>
            </execution>
        </executions>
    </plugin>

    <!-- ── JAR plugin ────────────────────────────────────────────────── -->
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
            <archive>
                <manifestEntries>
                    <Plugin-Class>
                        com.babcock.openfire.plugin.DeleteMessagePlugin
                    </Plugin-Class>
                </manifestEntries>
            </archive>
            <finalName>muc-message-delete</finalName>
        </configuration>
    </plugin>
</plugins>
</build>
</build>
