<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.babcock.openfire</groupId>
    <artifactId>message-delete-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Message Delete Plugin</name>
    <description>
        Openfire plugin that exposes a REST endpoint to delete/retract
        a MUC message from ofMessageArchive by messageId.
    </description>

    <properties>
        <java.version>11</java.version>
        <openfire.version>5.0.4</openfire.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Openfire core — provided by the server at runtime -->
        <dependency>
            <groupId>org.igniterealtime.openfire</groupId>
            <artifactId>xmppserver</artifactId>
            <version>${openfire.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jersey for REST — provided by Openfire admin console -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-server</artifactId>
            <version>2.40</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet</artifactId>
            <version>2.40</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Openfire reads these to register the plugin -->
                            <Plugin-Class>
                                com.babcock.openfire.plugin.MessageDeletePlugin
                            </Plugin-Class>
                        </manifestEntries>
                    </archive>
                    <!-- Output to plugins directory name expected by Openfire -->
                    <finalName>message-delete</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>igniterealtime</id>
            <name>Ignite Realtime Repository</name>
            <url>https://igniterealtime.org/archiva/repository/maven/</url>
        </repository>
    </repositories>
</project>



<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0
          http://maven.apache.org/xsd/assembly-2.1.0.xsd">

<id>plugin</id>
<formats>
    <format>jar</format>
</formats>
<includeBaseDirectory>false</includeBaseDirectory>

<files>
    <!-- plugin.xml at root -->
    <file>
        <source>src/main/resources/plugin.xml</source>
        <destName>plugin.xml</destName>
        <fileMode>0644</fileMode>
    </file>
</files>

<fileSets>
    <!-- web.xml inside WEB-INF -->
    <fileSet>
        <directory>src/main/webapp</directory>
        <outputDirectory>/</outputDirectory>
        <includes>
            <include>WEB-INF/web.xml</include>
        </includes>
    </fileSet>
</fileSets>

<dependencySets>
    <!-- All classes and dependencies go into lib/ -->
    <dependencySet>
        <outputDirectory>lib</outputDirectory>
        <useProjectArtifact>true</useProjectArtifact>
        <scope>runtime</scope>
    </dependencySet>
</dependencySets>

</assembly>


<build>
<finalName>muc-message-delete</finalName>
<plugins>

    <!-- Step 1: build the classes JAR normally -->
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
            <outputDirectory>${project.build.directory}/lib</outputDirectory>
            <finalName>muc-message-delete</finalName>
        </configuration>
    </plugin>

    <!-- Step 2: assemble final plugin JAR with correct structure -->
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
            <execution>
                <id>make-plugin-jar</id>
                <phase>package</phase>
                <goals>
                    <goal>single</goal>
                </goals>
                <configuration>
                    <finalName>muc-message-delete</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors>
                        <descriptor>src/assembly/plugin.xml</descriptor>
                    </descriptors>
                </configuration>
            </execution>
        </executions>
    </plugin>

</plugins>
</build>



