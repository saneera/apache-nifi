# Black NiFi — settings read by deploy.sh (one KEY=VALUE per line; comments only on their own line)
# The Job runs inside the cluster, so in-cluster service names usually work.
# Use https://host:port only — the script adds /nifi-api and /nifi-registry-api itself.
NIFI_URL=https://nifi-black.hfc2-nifi.svc:8443
REGISTRY_URL=https://nifi-registry-black.hfc2-nifi.svc:18443

# Remote Process Group target (keeps /nifi) — Black sends to Red
TARGET_RPG_URL=https://nifi-red.example.local:8443/nifi

# NiFi Registry CLIENT id (NiFi UI: Controller Settings > Registry Clients) — must be a NiFi Registry client
REGISTRY_ID=CHANGE-ME-registry-client-id

# Registry BUCKET id (e.g. the hfc2-black-flows bucket created by the wizard)
REGISTRY_BUCKET_ID=CHANGE-ME-bucket-id

# true = start process groups after deploy, false = leave them STOPPED
START_FLOW=false
