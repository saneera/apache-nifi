# Parameter overrides for deploy.sh: PARAM_<name>=<value>
#
# The script strips "PARAM_" and turns "_" into "." (check the VERIFY line in deploy.sh), so
#   PARAM_listen_port=9443   ->  parameter "listen.port" = 9443
#
# IMPORTANT
# - At least ONE PARAM_ line is required. With none, deploy.sh stops with exit code 1 and no message
#   (grep finds nothing and `set -euo pipefail` ends the script inside build_param_json).
# - update_parameter_contexts applies these to EVERY parameter context in this NiFi that has a
#   parameter with the same name — not only the flows being deployed.
# - Do NOT put passwords or tokens here: this file is in Git. Sensitive values belong in a Secret.

PARAM_CHANGE_ME_param_name=CHANGE_ME
