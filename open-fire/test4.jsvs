import { ref } from 'vue'
import { getAddressBooks, getMeus } from '../api/requests'

/**
 * Shared MEU / TEU name lookup, the same logic as fetchMeusList() + fetchTeusList()
 * in CircuitParticipants.vue. Loaded once and reused by every component.
 */

export enum ParticipantType {
  TEU = 'teu',
  MEU = 'meu',
  FEATURE = 'feature',
}

export interface Participant {
  id: string
  label: string
  type: ParticipantType
}

/**
 * Chip icon per participant type, the same as getParticipantIcon() in CircuitParticipants.vue.
 * TODO: copy the exact mdi names from that file if these differ.
 */
export function getParticipantIcon(type?: ParticipantType): string {
  switch (type) {
    case ParticipantType.TEU:
      return 'mdi-account'
    case ParticipantType.MEU:
      return 'mdi-airplane'
    case ParticipantType.FEATURE:
      return 'mdi-map-marker'
    default:
      return ''
  }
}

const directory = ref<Participant[]>([])
const loading = ref(false)
let inflight: Promise<void> | null = null

async function load(): Promise<void> {
  loading.value = true
  try {
    const [meus, teus] = await Promise.all([getMeus(), getAddressBooks()])
    const list: Participant[] = []

    meus
      ?.filter((m) => m.id && m.name)
      .forEach((m) => list.push({ id: m.id!, label: m.name!, type: ParticipantType.MEU }))

    teus
      ?.filter((t) => t.addressBookId && t.name)
      .forEach((t) =>
        list.push({ id: t.addressBookId!, label: t.name!, type: ParticipantType.TEU }),
      )

    directory.value = list
  } finally {
    loading.value = false
  }
}

export function useParticipantDirectory() {
  if (!inflight) {
    inflight = load().catch((e) => {
      inflight = null // allow a retry next time
      console.error('Could not load participants', e)
    })
  }

  /** Name for a meu / teu id; falls back to the id if it isn't known. */
  const labelFor = (id: string) => directory.value.find((p) => p.id === id)?.label ?? id

  /** Force a fresh fetch (e.g. after new MEUs / TEUs are added). */
  const reload = () => {
    inflight = load()
    return inflight
  }

  return { directory, loading, labelFor, reload }
}


