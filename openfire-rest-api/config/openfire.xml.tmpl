<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template rendered at container startup by entrypoint.sh.
  ${VAR} placeholders are replaced from Kubernetes env vars.

  This file configures MySQL connectivity and bypasses the web setup wizard.
  Everything else (plugins, services) is seeded via ofProperty SQL rows.
-->
<jive>

  <!-- ── SETUP WIZARD BYPASS ──────────────────────────────────────────── -->
  <setup>true</setup>

  <!-- ── DOMAIN ────────────────────────────────────────────────────────── -->
  <domain>${XMPP_DOMAIN}</domain>
  <fqdn>${XMPP_FQDN}</fqdn>

  <!-- ── DATABASE: MySQL ───────────────────────────────────────────────── -->
  <connectionProvider>
    <className>org.jivesoftware.database.DefaultConnectionProvider</className>
  </connectionProvider>

  <database>
    <defaultProvider>
      <driver>com.mysql.cj.jdbc.Driver</driver>
      <serverURL>jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&amp;characterEncoding=UTF-8&amp;rewriteBatchedStatements=true&amp;useUnicode=true&amp;serverTimezone=UTC</serverURL>
      <username>${MYSQL_USER}</username>
      <password>${MYSQL_PASSWORD}</password>
      <minConnections>5</minConnections>
      <maxConnections>25</maxConnections>
      <connectionTimeout>1.0</connectionTimeout>
    </defaultProvider>
  </database>

  <!-- ── ADMIN CONSOLE ─────────────────────────────────────────────────── -->
  <adminConsole>
    <port>9090</port>
    <securePort>9091</securePort>
  </adminConsole>

  <!-- ── LOCALE ────────────────────────────────────────────────────────── -->
  <locale>en</locale>

</jive>
