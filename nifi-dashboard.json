      "type": "table",
      "title": "Processor activity - last 5 min (red = no output)",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Sort/filter by column. Stopped processors show 0 in/out.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nifi_amount_flowfiles_received{job=\"$job\",component_type=\"Processor\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nifi_amount_flowfiles_sent{job=\"$job\",component_type=\"Processor\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nifi_amount_threads_active{job=\"$job\",component_type=\"Processor\"}",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "exported_instance": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true,
              "component_id": true,
              "parent_id": true,
              "component_type": true
            },
            "renameByName": {
              "component_name": "Processor",
              "Value #A": "In (5 min)",
              "Value #B": "Out (5 min)",
              "Value #C": "Active threads"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Out (5 min)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Out (5 min)",
            "desc": false
          }
        ]
      }
    }
