import lombok.extern.slf4j.Slf4j;
import org.jivesoftware.smack.packet.Message;
import org.jivesoftware.smack.packet.Presence;
import org.jivesoftware.smackx.muc.MultiUserChat;
import org.jivesoftware.smackx.muc.MultiUserChatManager;
import org.jivesoftware.smackx.muc.ParticipantStatusListener;
import org.jivesoftware.smackx.xdata.Form;
import org.jivesoftware.smackx.xdata.FormField;
import org.jivesoftware.smackx.xdata.packet.DataForm;
import org.jxmpp.jid.EntityBareJid;
import org.jxmpp.jid.EntityFullJid;
import org.jxmpp.jid.Jid;
import org.jxmpp.jid.impl.JidCreate;
import org.jxmpp.jid.parts.Resourcepart;

@Slf4j
public class ChatRoomService {

    private final MultiUserChatManager manager;

    private static final String MUC_ROOM_CONFIG =
            "muc#roomconfig";

    public ChatRoomService(
            MultiUserChatManager manager) {

        this.manager = manager;
    }

    public RoomInfo createRoom(
            String roomName,
            String roomDescription,
            DriverConfig driverConfig)
            throws Exception {

        try {

            String roomJidString =
                    roomName +
                    "@conference.openfire-xmpp-dev";

            EntityBareJid roomJid =
                    JidCreate.entityBareFrom(
                            roomJidString);

            MultiUserChat muc =
                    manager.getMultiUserChat(roomJid);

            //-----------------------------------------
            // Create room
            //-----------------------------------------

            muc.create(
                    Resourcepart.from(roomName));

            //-----------------------------------------
            // Configure room
            //-----------------------------------------

            Form form =
                    muc.getConfigurationForm();

            Form submitForm =
                    form.createAnswerForm();

            submitForm.setAnswer(
                    MUC_ROOM_CONFIG + "_roomname",
                    roomName);

            submitForm.setAnswer(
                    MUC_ROOM_CONFIG + "_roomdesc",
                    roomDescription);

            submitForm.setAnswer(
                    MUC_ROOM_CONFIG +
                    "_persistentroom",
                    true);

            submitForm.setAnswer(
                    MUC_ROOM_CONFIG +
                    "_publicroom",
                    true);

            submitForm.setAnswer(
                    MUC_ROOM_CONFIG +
                    "_passwordprotectedroom",
                    false);

            if (driverConfig.getMaxUsers()
                    != null) {

                submitForm.setAnswer(
                        MUC_ROOM_CONFIG +
                        "_maxusers",
                        driverConfig
                                .getMaxUsers()
                                .toString());
            }

            muc.sendConfigurationForm(
                    submitForm);

            //-----------------------------------------
            // Register listeners
            //-----------------------------------------

            registerRoomListeners(muc);

            //-----------------------------------------
            // Get room info
            //-----------------------------------------

            RoomInfo roomInfo =
                    manager.getRoomInfo(roomJid);

            log.info(
                    "Room {} created",
                    roomName);

            return roomInfo;

        } catch (Exception ex) {

            log.error(
                    "Error creating room {}",
                    roomName,
                    ex);

            throw ex;
        }
    }

    private void registerRoomListeners(
            MultiUserChat muc) {

        //------------------------------------
        // Join / Leave
        //------------------------------------

        muc.addParticipantListener(
                presence -> {

            log.info(
                "Presence {} {}",
                presence.getType(),
                presence.getFrom()
            );

            if (presence.getType()
                    == Presence.Type.available) {

                log.info(
                    "Participant joined {}",
                    presence.getFrom()
                );
            }

            if (presence.getType()
                    == Presence.Type.unavailable) {

                log.info(
                    "Participant left {}",
                    presence.getFrom()
                );
            }
        });

        //------------------------------------
        // Message listener
        //------------------------------------

        muc.addMessageListener(
                (Message message) -> {

            if(message.getBody()==null){
                return;
            }

            log.info(
                "Room message [{}] from {}",
                message.getBody(),
                message.getFrom()
            );

            log.info(
                "Stanza id {}",
                message.getStanzaId()
            );
        });

        //------------------------------------
        // Participant status
        //------------------------------------

        muc.addParticipantStatusListener(
                new ParticipantStatusListener() {

            @Override
            public void joined(
                    EntityFullJid participant) {

                log.info(
                    "{} joined room",
                    participant);
            }

            @Override
            public void left(
                    EntityFullJid participant) {

                log.info(
                    "{} left room",
                    participant);
            }

            @Override
            public void kicked(
                    EntityFullJid participant,
                    Jid actor,
                    String reason) {

                log.info(
                    "{} kicked by {}",
                    participant,
                    actor);
            }

            @Override
            public void banned(
                    EntityFullJid participant,
                    Jid actor,
                    String reason) {}

            @Override
            public void voiceGranted(
                    EntityFullJid participant){}

            @Override
            public void voiceRevoked(
                    EntityFullJid participant){}

            @Override
            public void membershipGranted(
                    EntityFullJid participant){}

            @Override
            public void membershipRevoked(
                    EntityFullJid participant){}

            @Override
            public void moderatorGranted(
                    EntityFullJid participant){}

            @Override
            public void moderatorRevoked(
                    EntityFullJid participant){}

