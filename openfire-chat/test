private final Map<String, MessageListener> roomListeners =
        new ConcurrentHashMap<>();

/**
 * Register room message listener
 *
 * @param roomName
 * @param participantName
 * @param muc
 */
public void registerRoomListener(
        String roomName,
        String participantName,
        MultiUserChat muc
) {

    String roomKey = roomName + ":" + participantName;

    /**
     * Prevent duplicate listener registration
     */
    if (!registeredRooms.add(roomKey)) {
        return;
    }

    log.info(
            "Registering room listener for [{}] in room [{}]",
            participantName,
            roomName
    );

    MessageListener listener = message -> {

        try {

            /**
             * Ignore delayed/history messages
             */
            DelayInformation delay =
                    DelayInformation.from(message);

            if (delay != null) {

                log.info(
                        "Ignoring delayed message for room [{}]",
                        roomName
                );

                return;
            }

            messageListenerService.processRoomMessage(
                    roomName,
                    participantName,
                    message
            );

        } catch (Exception ex) {

            log.error(
                    "Error processing room message",
                    ex
            );
        }
    };

    /**
     * Store listener reference
     */
    roomListeners.put(roomKey, listener);

    /**
     * Attach listener to room
     */
    muc.addMessageListener(listener);
}



public MultiUserChat removeParticipantFromTheRoom(
        String roomName,
        String userName
) throws IllegalArgumentException {

    String roomKey = roomName + ":" + userName;

    try {

        XMPPTCPConnection participantConnection =
                xmppConnectionManager.getParticipantConnection(
                        userName,
                        chatGatewayProperties.getParticipantPassword()
                );

        MultiUserChatManager manager =
                chatManagerProvider.getManager(
                        participantConnection
                );

        String roomJidString =
                buildEntityBareJid(
                        roomName,
                        chatGatewayProperties.getServiceName(),
                        chatGatewayProperties.getDomain()
                );

        EntityBareJid roomJid =
                JidCreate.entityBareFrom(
                        roomJidString
                );

        MultiUserChat muc =
                manager.getMultiUserChat(roomJid);

        /**
         * Remove listener before leaving room
         */
        MessageListener listener =
                roomListeners.remove(roomKey);

        if (listener != null) {

            muc.removeMessageListener(listener);

            log.info(
                    "Removed message listener for [{}]",
                    roomKey
            );
        }

        /**
         * Leave room
         */
        muc.leave();

        registeredRooms.remove(roomKey);

        joinedRooms.remove(roomKey);

        xmppConnectionManager.disconnectParticipant(
                userName
        );

        log.info(
                "Participant [{}] left room [{}]",
                userName,
                roomName
        );

        return muc;

    } catch (Exception e) {

        log.error(
                "Error leaving room [{}] for participant [{}]",
                roomName,
                userName,
                e
        );

        throw new IllegalArgumentException(
                "Error leaving participant from room",
                e
        );
    }
}




public List<RoomMessageResponse> readMessages(
        ReadRoomMessagesCommand command
) {

    try {

        XMPPTCPConnection connection =
                xmppConnectionManager.getParticipantConnection(
                        command.getParticipantName(),
                        chatGatewayProperties.getParticipantPassword()
                );

        MultiUserChatManager manager =
                chatManagerProvider.getManager(connection);

        String roomJidString =
                buildEntityBareJid(
                        command.getRoomName(),
                        chatGatewayProperties.getServiceName(),
                        chatGatewayProperties.getDomain()
                );

        EntityBareJid roomJid =
                JidCreate.entityBareFrom(roomJidString);

        MultiUserChat muc =
                manager.getMultiUserChat(roomJid);

        MamManager mamManager =
                MamManager.getInstanceFor(muc);

        MamManager.MamQueryArgs mamQueryArgs =
                MamManager.MamQueryArgs.builder()
                        .querySince(
                                Date.from(command.getSince())
                        )
                        .setResultPageSize(
                                command.getLimit()
                        )
                        .build();

        MamManager.MamQueryResult result =
                mamManager.queryArchive(
                        mamQueryArgs
                );

        List<RoomMessageResponse> responses =
                new ArrayList<>();

        for (Message message : result.forwardedMessages) {

            if (message.getBody() == null) {
                continue;
            }

            DelayInformation delay =
                    DelayInformation.from(message);

            Instant timestamp =
                    delay != null
                            ? delay.getStamp().toInstant()
                            : Instant.now();

            responses.add(
                    RoomMessageResponse.builder()
                            .messageId(
                                    message.getStanzaId()
                            )
                            .sender(
                                    message.getFrom().toString()
                            )
                            .body(
                                    message.getBody()
                            )
                            .timestamp(timestamp)
                            .build()
            );
        }

        return responses;

    } catch (Exception e) {

        log.error(
                "Error reading room messages",
                e
        );

        throw new IllegalArgumentException(
                "Error reading room messages",
                e
        );
    }
}


